+      .replace(/>/g, "&gt;")
+      .replace(/"/g, "&quot;")
+      .replace(/'/g, "&#039;");
+  }
+
+  // Copy text to system clipboard with visual button feedback
+  async function copyToClipboard(text, btnElement) {
