# ==============================================================================
# LeadDesk AI - Cluster Chat GitHub Relay Configuration Template
# Copy to /opt/hq/github_relay.env and configure permissions:
#   sudo cp hq/github_relay.env.example /opt/hq/github_relay.env
#   sudo chmod 600 /opt/hq/github_relay.env
# ==============================================================================

# Required: GitHub Personal Access Token (Fine-grained or Classic PAT)
# Needs repository permissions: Contents (Read & Write), Actions (Read & Write)
GITHUB_TOKEN=github_pat_replace_with_your_token

# Target GitHub repository hosting the relay queue (format: owner/repo)
GITHUB_REPO=mohammadlali0707-stack/agw-workers

# Target Git branch for the queue (default: main)
GITHUB_BRANCH=main

# Path to the LeadDesk Cluster Chat SQLite database on the VPS
CLUSTER_CHAT_DB=/opt/hq/cluster_chat.db

# Optional: Local Cluster Chat HTTP API endpoint to broadcast incoming GitHub messages
# via Server-Sent Events (SSE) to active web room participants in real time.
# Leave blank if local cluster-chat reads directly from SQLite.
CLUSTER_CHAT_API_URL=http://127.0.0.1:8090/api/cluster-chat/messages

# Optional: Shared symmetric encryption passphrase for AES-256-GCM.
# When configured, message payloads and attachments stored in the GitHub repository
# are encrypted end-to-end with PBKDF2 key derivation (100,000 iterations).
# Must match the passphrase configured in the Static Web UI fallback client.
RELAY_SHARED_KEY=

# Polling cadence in seconds (default: 8)
# Conditional ETag caching ensures HTTP 304 responses consume 0 rate limit units.
RELAY_POLL_INTERVAL=8

# Local directory where downloaded attachments are stored
CLUSTER_CHAT_UPLOAD_DIR=/opt/hq/data/cluster-chat/uploads
