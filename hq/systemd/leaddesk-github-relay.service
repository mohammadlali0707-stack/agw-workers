[Unit]
Description=LeadDesk AI Cluster Chat GitHub Relay Daemon
Documentation=https://github.com/mohammadlali0707-stack/agw-workers
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/hq
EnvironmentFile=-/opt/hq/github_relay.env
ExecStart=/usr/bin/python3 /opt/hq/github_relay.py --daemon
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=github-relay

# Process security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/hq

[Install]
WantedBy=multi-user.target
